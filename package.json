{
  "name": "numberisland",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:offline": "node tools/check-offline.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm boundaries && pnpm test && pnpm build && pnpm check:offline && pnpm size",
    "check:score": "tsx tools/score/check-score.ts",
    "curriculum:verify": "tsx tools/gen-curriculum-verify.ts",
    "images:requests": "tsx tools/gen-image-requests.ts",
    "bench": "tsx tools/bench.ts",
    "size": "size-limit",
    "images:ingest": "tsx tools/ingest-images.ts"
  },
  "dependencies": {
    "@fontsource/fredoka": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "bitecs": "0.4.0",
    "idb": "8.0.4",
    "motion": "14.4.0",
    "pretendard": "1.3.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "temporal-polyfill": "1.0.6",
    "three": "0.186.1",
    "valibot": "1.5.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@babel/core": "8.0.7",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@rolldown/plugin-babel": "0.2.4",
    "@size-limit/preset-app": "14.2.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "babel-plugin-react-compiler": "1.0.0",
    "dependency-cruiser": "18.7.0",
    "fake-indexeddb": "6.2.6",
    "fast-check": "4.10.2",
    "size-limit": "14.2.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
